# SolarWatch — environment configuration
# Copy to .env and fill in real values before starting the app.
#
# For Kubernetes, these are set via the Helm values.yaml secrets section
# and mounted as environment variables from a K8s Secret. Do not put
# real credentials in values.yaml — use external secret management.

# ============================================================
# Application settings
# ============================================================

# Set to "production" in live environments (enables HSTS, strict CSP,
# HTTPS-only cookies). Leave as "development" for local dev.
APP_ENV=development

# Signs session cookies. Must be IDENTICAL across all pod replicas and
# stable across restarts. Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Set true when running behind Traefik, ingress-nginx, or Cloudflare.
# Required for rate limiting to use the real client IP.
APP_PROXY_FIX=false

# ============================================================
# Admin bootstrap credentials
# ============================================================
# Required on first start. The app creates the admin account from these.
# The admin is forced to change the password on first login.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-now

# Set true temporarily to reset the admin password from APP_ADMIN_PASSWORD.
# APP_ADMIN_RESET_PASSWORD=false

# ============================================================
# Database connection (PostgreSQL)
# ============================================================
# Option A — single URL (recommended, matches Helm databaseUrl):
# DATABASE_URL=postgresql+psycopg2://solarwatch_user:password@your-postgres-host:5432/solarwatch

# Option B — individual fields:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=solarwatch_user
DB_PASSWORD=changeme
DB_NAME=solarwatch

# Connection pool per worker process.
# Max connections = pods × workers × (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# Default (2 pods × 2 workers × 5): 20 connections — adjust to your PG capacity.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30

# ============================================================
# Rate limiting
# ============================================================
# RATE_LIMIT_LOGIN=10/minute
# RATE_LIMIT_DEFAULT=60/minute

# ============================================================
# Collector settings (collector.py — uses same DB vars as the web app)
# ============================================================
# The collector reads DATABASE_URL (or DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME)
# from this same .env file — no separate PG_* vars needed.
# Just uncomment and set the DB connection above, then run: python collector.py
#
# POLL_INTERVAL=60        # seconds between inverter poll cycles
# MAX_RETRIES=3           # retries per inverter per cycle
# RETRY_DELAY=5           # seconds between retries
# CONFIG_RELOAD=300       # seconds between site config reloads from DB
# WEATHER_INTERVAL=900    # seconds between weather polls (15 min)
#
# Victron MQTT port (default 1883 — only change if your Cerbo GX uses a non-standard port):
# VICTRON_MQTT_PORT=1883
