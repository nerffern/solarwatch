# ============================================================
# Database connection settings (PostgreSQL)
# ============================================================
# Option 1: single DATABASE_URL (recommended for K8s — store as a K8s Secret)
# DATABASE_URL=postgresql+psycopg2://app_user:password@postgres-ha.hfisystems.com:5432/app_db

# Option 2: individual fields
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=changeme
DB_NAME=app_db

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ============================================================
# Application settings
# ============================================================
# SECRET_KEY signs session cookies. Must be identical across ALL pod replicas
# and stable across restarts. Store as a K8s Secret and mount as env var.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Set to "production" in live environments.
APP_ENV=development

# ============================================================
# Admin bootstrap credentials
# ============================================================
# Required on first start. The app provisions the admin account from these.
# To recover admin access: set APP_ADMIN_RESET_PASSWORD=true temporarily.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-now
# APP_ADMIN_RESET_PASSWORD=false

# ============================================================
# Reverse proxy support (Traefik / ingress-nginx on K8s)
# ============================================================
APP_PROXY_FIX=false

# ============================================================
# CSP / Security toggles (optional overrides)
# ============================================================
# CSP_REPORT_ONLY=true
# CSP_ALLOW_INLINE_SCRIPTS=true
